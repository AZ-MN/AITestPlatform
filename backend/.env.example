# ============================================================
# 测试用例智能生成平台 - 后端环境配置
# 复制本文件为 .env 并填入真实的 API Key
# ============================================================

# 调试模式：生产环境必须为 false；本地开发可设为 true
DEBUG=true

# 安全密钥（生产环境请使用 openssl rand -hex 32 生成，禁止使用占位值）
SECRET_KEY=your-secret-key-change-in-production

# 数据库（默认 SQLite，生产建议 PostgreSQL）
DATABASE_URL=sqlite:///./aitest.db

# 文件上传目录
UPLOAD_DIR=./uploads

# ── AI 模型配置（按需填写，至少配置一个） ──────────────────────

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# 通义千问
TONGYI_API_KEY=
TONGYI_DEFAULT_MODEL=qwen-max

# 智谱 GLM
ZHIPU_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# 默认使用的供应商（openai / anthropic / tongyi / zhipu / deepseek）
DEFAULT_AI_PROVIDER=openai
